# Copie para `.env` e ajuste o que for necessario:
#     cp .env.example .env
#
# O arquivo `.env` esta no .gitignore e nunca deve ser versionado.
# Estes valores sao consumidos pelo docker-compose.yml.
#
# Nada aqui e obrigatorio: o compose tem um padrao para cada variavel, e
# `docker compose up --build` funciona sem nenhum .env. Este arquivo existe para
# quando algum padrao nao servir — tipicamente uma porta ja ocupada na maquina.

# ---------- Portas publicadas no host ----------
# Sao SO as portas de fora. Dentro da rede do compose os servicos se encontram pelo nome do
# container, nas portas padrao — trocar qualquer valor aqui nao quebra a conexao entre eles.

# 5433, e nao 5432, porque e comum a maquina ja ter um PostgreSQL nativo instalado; com as
# duas na mesma porta a aplicacao conecta na instancia errada e falha a autenticacao.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
GATEWAY_PORT=8080
FRONTEND_PORT=5173

# ---------- PostgreSQL ----------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres

# Um banco e um usuario por servico (database per service)
AUTH_DB_NAME=authdb
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_pass

EVENT_DB_NAME=eventdb
EVENT_DB_USER=event_user
EVENT_DB_PASSWORD=event_pass

BOOKING_DB_NAME=bookingdb
BOOKING_DB_USER=booking_user
BOOKING_DB_PASSWORD=booking_pass

# ---------- RabbitMQ ----------
RABBITMQ_USER=ticket
RABBITMQ_PASSWORD=ticket

# ---------- JWT ----------
# Segredo do HS256, compartilhado por todos os servicos e pelo gateway — e o que permite a
# cada um validar o token sem chamar o auth-service. Minimo de 32 bytes. Gere um valor
# proprio, por exemplo:
#     openssl rand -base64 48
JWT_SECRET=desenvolvimento-local-troque-este-segredo-antes-de-publicar

# ---------- auth-service ----------
# O profile `dev` aplica o seed do primeiro administrador (admin@ticket.dev). Sem ele o banco
# nasce sem admin algum, e nao ha caminho para criar o primeiro evento — o cadastro publico
# sempre gera USER.
#
# Deixe VAZIO em qualquer ambiente publico: o seed usa uma senha publicamente conhecida.
AUTH_PROFILE=dev

# ---------- Frontend e CORS ----------
# Endereco do gateway pelo qual o NAVEGADOR chama. Embutido no bundle na compilacao da
# imagem: mudar aqui exige `docker compose build frontend`.
VITE_API_URL=http://localhost:8080/api

# Origem liberada no CORS do gateway. Precisa casar com FRONTEND_PORT, ou o navegador barra
# todas as chamadas.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- payment-simulator ----------
# Provedor de pagamento falso, instavel de proposito, para o retry do booking-service ter
# contra o que se defender.
#
# Os padroes servem a demonstracao, e nao a uma media realista: com 2% de falha seria preciso
# gravar cinquenta pagamentos para o retry aparecer uma vez.
#
# Zere os DOIS para rodar sem instabilidade — util ao gravar o fluxo de compra, em que o
# assunto e outro.
PAGAMENTO_FALHA_PERCENTUAL=30
PAGAMENTO_RECUSA_PERCENTUAL=5

# ---------- Resiliencia (booking-service) ----------
# Circuit breaker da chamada ao event-service. A janela e por CONTAGEM, e nao por tempo: a
# hidratacao acontece uma vez por evento, entao o volume e baixo e irregular.
CB_EVENT_JANELA=10
CB_EVENT_MINIMO=5
CB_EVENT_LIMIAR=50
# Tempo que o circuito passa aberto antes de deixar passar as chamadas de teste. Curto para a
# demonstracao nao ficar parada; num ambiente real seria bem maior.
CB_EVENT_ESPERA=10s

# Retry da chamada ao provedor de pagamento: a tentativa original e mais tres.
RETRY_PAGAMENTO_TENTATIVAS=4
RETRY_PAGAMENTO_ESPERA=200ms

# ---------- Tracing (OpenTelemetry / Jaeger) ----------
# Fracao das requisicoes que geram trace. 1.0 = todas.
#
# Correto para estudo, errado em producao: guardar um trace de cada requisicao de um sistema
# com volume real custa armazenamento e banda para registrar, na maioria, requisicoes que
# deram certo e ninguem vai olhar. Aqui o valor e didatico — cada reserva feita numa
# demonstracao precisa aparecer, ou o Jaeger fica vazio bem na hora de mostrar.
TRACING_AMOSTRAGEM=1.0

# Teto de traces guardados em memoria pelo Jaeger. Nao ha volume: sao dados de diagnostico de
# desenvolvimento, e um `docker compose down` deve limpa-los junto com o resto.
JAEGER_MAX_TRACES=20000

# Portas publicadas do Jaeger. A 16686 e a interface web; a 4318 recebe os spans e fica
# publicada para permitir rodar um servico pela IDE, fora do compose, e ainda ver os spans.
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP_PORT=4318
