# Copie para `.env` e ajuste o que for necessario:
#     cp .env.example .env
#
# O arquivo `.env` esta no .gitignore e nunca deve ser versionado.
# Estes valores sao consumidos pelo docker-compose.yml.

# ---------- PostgreSQL ----------
# Porta publicada no host. 5433, e nao 5432, porque e comum a maquina ja ter um
# PostgreSQL nativo instalado; com as duas na mesma porta a aplicacao conecta na
# instancia errada e falha a autenticacao. Dentro da rede do compose continua 5432.
POSTGRES_HOST_PORT=5433
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres

# Um banco e um usuario por servico (database per service)
AUTH_DB_NAME=authdb
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_pass

EVENT_DB_NAME=eventdb
EVENT_DB_USER=event_user
EVENT_DB_PASSWORD=event_pass

BOOKING_DB_NAME=bookingdb
BOOKING_DB_USER=booking_user
BOOKING_DB_PASSWORD=booking_pass

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- RabbitMQ ----------
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=ticket
RABBITMQ_PASSWORD=ticket
