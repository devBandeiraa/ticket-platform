<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath/>
	</parent>
	<groupId>com.devbandeiraa</groupId>
	<artifactId>payment-simulator</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>payment-simulator</name>
	<description>Gateway de pagamento falso, instavel de proposito, para exercitar retry</description>

	<properties>
		<java.version>17</java.version>
	</properties>

	<!--
		Deliberadamente magro. Este servico existe para ser o "terceiro" da arquitetura: aquele
		que nao se controla, cai quando quer e obriga quem o chama a se defender.

		Sem banco, sem Redis, sem RabbitMQ e sem seguranca. Nao ha estado que precise sobreviver a
		um restart — perder as autorizacoes em memoria e ate desejavel, porque e assim que um
		provedor de verdade se comporta do ponto de vista de quem integra: fonte externa, opaca e
		sem garantia nenhuma de continuidade.
	-->
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- Health para o compose saber quando o servico esta de pe, e metricas para a fase
		     seguinte de observabilidade. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!--
			Tracing distribuido. A ponte do Micrometer instrumenta sozinha o que ja e Spring, e o
			exportador OTLP entrega os spans ao Jaeger. Sem versao: as duas vem gerenciadas pela BOM
			do Spring Boot. Ver o comentario no pom do booking-service para o porque de nao usar o
			agente Java do OpenTelemetry.
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-otel</artifactId>
		</dependency>
		<dependency>
			<groupId>io.opentelemetry</groupId>
			<artifactId>opentelemetry-exporter-otlp</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
