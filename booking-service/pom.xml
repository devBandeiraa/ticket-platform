<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath/>
	</parent>
	<groupId>com.devbandeiraa</groupId>
	<artifactId>booking-service</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>booking-service</name>
	<description>Servico de reserva de ingressos com lock distribuido em Redis</description>

	<properties>
		<java.version>17</java.version>
		<springdoc.version>2.8.17</springdoc.version>
		<resilience4j.version>2.3.0</resilience4j.version>
		<!-- Declarada porque, diferente do api-gateway, este modulo nao importa a BOM do Spring
		     Cloud — que e de onde aquele tira a versao do mockwebserver sem precisar dizer. -->
		<mockwebserver.version>4.12.0</mockwebserver.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!--
			Tracing distribuido. A ponte do Micrometer instrumenta sozinha o que ja e Spring —
			controllers, RestClient, listeners do RabbitMQ — e o exportador OTLP entrega os spans
			ao Jaeger. Sem versao: as duas vem gerenciadas pela BOM do Spring Boot.

			Escolhido em vez do agente Java do OpenTelemetry porque o agente instrumenta por
			bytecode, sem aparecer no codigo: funciona, mas nada no repositorio explicaria de onde
			vem o tracing. Aqui a instrumentacao e uma dependencia declarada e uma configuracao
			legivel.
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-otel</artifactId>
		</dependency>
		<dependency>
			<groupId>io.opentelemetry</groupId>
			<artifactId>opentelemetry-exporter-otlp</artifactId>
		</dependency>
		<!-- Validacao de JWT, papeis e formato de erro. O starter de security vem declarado a
		     parte porque no shared-security ele e provided, justamente para nao ser transitivo. -->
		<dependency>
			<groupId>com.devbandeiraa</groupId>
			<artifactId>shared-security</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!--
			Circuit breaker na chamada ao event-service e retry na chamada ao payment-simulator.

			A variante `spring-boot3` e a que registra os endpoints do Actuator e le a
			configuracao do application.yml; a biblioteca nua exigiria montar cada instancia em
			codigo. A versao vem declarada porque o Resilience4j nao faz parte da BOM do Boot.
		-->
		<dependency>
			<groupId>io.github.resilience4j</groupId>
			<artifactId>resilience4j-spring-boot3</artifactId>
			<version>${resilience4j.version}</version>
		</dependency>
		<!--
			As anotacoes do Resilience4j sao interceptadas por proxy, e sem AOP no classpath elas
			simplesmente nao fazem nada — sem erro, sem aviso. Declarado explicitamente para que a
			dependencia esteja visivel a quem le o POM, em vez de chegar por transitividade.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aop</artifactId>
		</dependency>

		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.amqp</groupId>
			<artifactId>spring-rabbit-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- H2 nao serve aqui: o teste central desta fase verifica que o PostgreSQL recusa o
		     overselling, e isso depende do isolamento e das constraints do banco real. Um
		     teste de concorrencia que passa em H2 e falha em producao seria pior que nenhum. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>rabbitmq</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
			Servidor HTTP de mentira no lugar do event-service e do provedor de pagamento.

			Um mock de objeto nao serviria para os testes de resiliencia: o que se precisa
			verificar e quantas requisicoes chegaram do outro lado do fio e com quais cabecalhos —
			se o retry realmente repetiu, se a chave de idempotencia se manteve, se o circuito
			aberto de fato deixou de chamar. Nada disso e observavel substituindo o cliente.
		-->
		<dependency>
			<groupId>com.squareup.okhttp3</groupId>
			<artifactId>mockwebserver</artifactId>
			<version>${mockwebserver.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- Documentacao OpenAPI gerada a partir dos proprios controllers. A versao vem
		     declarada porque o springdoc nao faz parte da BOM do Spring Boot; a linha 2.8.x e a
		     que acompanha o Boot 3.x, enquanto a 3.x ja mira o Boot 4. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
