<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath/>
	</parent>
	<groupId>com.devbandeiraa</groupId>
	<artifactId>api-gateway</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>api-gateway</name>
	<description>Porta de entrada unica: roteamento, validacao de JWT e rate limiting</description>

	<properties>
		<java.version>17</java.version>
		<springdoc.version>2.8.17</springdoc.version>
		<spring-cloud.version>2025.0.3</spring-cloud.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!--
			Tracing distribuido. A ponte do Micrometer instrumenta sozinha o que ja e Spring, e o
			exportador OTLP entrega os spans ao Jaeger. Sem versao: as duas vem gerenciadas pela BOM
			do Spring Boot. Ver o comentario no pom do booking-service para o porque de nao usar o
			agente Java do OpenTelemetry.
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-otel</artifactId>
		</dependency>
		<dependency>
			<groupId>io.opentelemetry</groupId>
			<artifactId>opentelemetry-exporter-otlp</artifactId>
		</dependency>

		<!--
			Backend do RequestRateLimiter. Precisa ser a variante reativa: o cliente bloqueante
			pararia a event loop do Netty a cada requisicao, que e exatamente o que o gateway
			nao pode fazer.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis-reactive</artifactId>
		</dependency>

		<!--
			Traz JwtTokenReader, JwtProperties, ApiError e Role. As dependencias de servlet do
			modulo sao `provided`, entao nao chegam aqui e o gateway continua reativo.
		-->
		<dependency>
			<groupId>com.devbandeiraa</groupId>
			<artifactId>shared-security</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.projectreactor</groupId>
			<artifactId>reactor-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Redis real nos testes: o rate limiter e um script Lua, e um dublê nao o executaria. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			Servico downstream de mentira. E o que permite verificar o que o gateway realmente
			encaminha — caminho apos o StripPrefix e cabecalhos injetados — em vez de apenas o
			status que ele devolve.
		-->
		<dependency>
			<groupId>com.squareup.okhttp3</groupId>
			<artifactId>mockwebserver</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Documentacao OpenAPI. A versao vem declarada porque o springdoc nao faz parte da
		     BOM do Spring Boot; a linha 2.8.x e a que acompanha o Boot 3.x, enquanto a 3.x ja
		     mira o Boot 4. Aqui e a variante webflux: o gateway e reativo, e a webmvc exigiria
		     um servlet container que este servico nao tem. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>
	</dependencies>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
