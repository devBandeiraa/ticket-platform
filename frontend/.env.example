# Endereco do api-gateway. Toda chamada do frontend passa por ele — nenhum servico e
# acessado diretamente.
#
# Fica apontando para o gateway de verdade, e nao para um proxy do Vite, de proposito: assim
# o desenvolvimento exercita o CORS configurado la. Um proxy esconderia uma origem mal
# liberada ate a primeira publicacao.
#
# Copie para .env.local para sobrescrever.
VITE_API_URL=http://localhost:8080/api
