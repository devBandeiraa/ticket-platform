<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath/>
	</parent>
	<groupId>com.devbandeiraa</groupId>
	<artifactId>shared-security</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>shared-security</name>
	<description>Validacao de JWT e formato de erro compartilhados entre os servicos</description>

	<properties>
		<java.version>17</java.version>
		<jjwt.version>0.12.7</jjwt.version>
	</properties>

	<dependencies>
		<!--
			Escopo provided de proposito: dependencia provided nao e transitiva.

			O api-gateway roda sobre WebFlux, e se este modulo propagasse
			spring-boot-starter-web o Spring Boot passaria a subi-lo como aplicacao servlet,
			quebrando o gateway. Cada servico ja declara o starter web ou reativo que lhe
			convem, e as classes verdadeiramente reutilizaveis daqui — JwtTokenReader,
			JwtProperties, ApiError, Role — nao dependem de servlet nenhum.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Usado diretamente por ApiError e SecurityErrorResponder, entao declarado aqui em
		     vez de depender do que o starter web traz por tabela. Tambem provided: cada
		     servico ja tem o seu, e a versao vem gerenciada pelo parent do Spring Boot. -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Gera os metadados que dao autocomplete das propriedades `jwt.*` na IDE. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-configuration-processor</artifactId>
			<optional>true</optional>
		</dependency>
	</dependencies>

	<!--
		Sem o spring-boot-maven-plugin de proposito: ele reempacotaria o modulo como jar
		executavel, e um jar assim nao serve como dependencia — as classes ficam sob
		BOOT-INF/classes e nao sao visiveis para quem o importa.
	-->

</project>
