# Normaliza fim de linha no repositorio.
* text=auto

# Scripts shell precisam de LF mesmo quando clonados no Windows: com CRLF o
# container Linux falha com "bad interpreter: no such file or directory".
*.sh text eol=lf
mvnw text eol=lf

# Arquivos que so fazem sentido com CRLF no Windows.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binarios: nunca converter.
*.jar binary
*.png binary
*.jpg binary
*.ico binary
